# 強制 shell 腳本用 LF，避免 Windows checkout 後在 Linux 出現 $'\r' 錯誤
*.sh text eol=lf

# 設定檔本身也用 LF
.gitattributes text eol=lf
.gitignore text eol=lf

# PowerShell 用 CRLF
*.ps1 text eol=crlf
*.psm1 text eol=crlf

# 一般文字
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# 二進位
*.png binary
*.jpg binary
*.zip binary
